  ],
  "ethos:access": "restricted",
  "ethos:visibility": "public",
  "ethos:origin": "downloaded",
  "ethos:restriction": "GADM data are freely available for academic and other non-commercial use; redistribution or commercial use is not allowed without prior permission from GADM (https://gadm.org/license.html). The files are therefore never uploaded or downloaded. They are read in place on the ICE-2 cluster, where the installation is accessible to ICE-2 members; contact the RESKit maintainers for access. Anyone else can obtain the same delivery from https://gadm.org/download_world36.html under GADM's terms.",
  "ethos:upstream": {
    "status": "available",
    "checked": "2026-09-28",
    "note": "gadm.org still serves version 3.6, including gadm36_levels_shp.zip, from its version 3.6 download page. The current GADM release is 4.1."
  },
  "ethos:coverage_note": "Holds the six shapefile layers of gadm36_levels_shp.zip. Not held: the zip itself (its members are identical to the extracted files), the GeoPackage deliveries of the same version, and the single-layer gadm36_shp.zip. The licence file shipped in the zip, license.txt, is kept unchanged with this entry's licence documents rather than among the data files.",
