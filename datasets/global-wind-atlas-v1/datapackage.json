{
  "$schema": "https://datapackage.org/profiles/2.0/datapackage.json",
  "name": "global-wind-atlas-v1",
  "title": "Global Wind Atlas 1.0, mean wind speed at 50, 100 and 200 m (global and Europe)",
  "description": "The first GWA release as held by ICE-2: global mean wind speed at 50, 100 and 200 m in WGS 84, plus European clips and a 5 km resample produced inside the institute. Superseded by global-wind-atlas (4.0); the oldest vintage on the cluster and the one behind the earliest RESKit wind results.",
  "homepage": "https://globalwindatlas.info/",
  "ethos:access": "public",
  "ethos:visibility": "public",
  "ethos:upstream": {
    "status": "superseded",
    "checked": "2026-09-07",
    "note": "No route to this release was found. globalwindatlas.info serves its rasters from a single version-less API endpoint (/api/gis/global/<layer>/<height>) that always redirects to whatever the current release is -- today that is GWA 4.0. The endpoint 302s to figshare behind a private_link token, and figshare's public file endpoint (api.figshare.com/v2/file/<id>) returns 404 for those ids, so the versioned item they belong to cannot be resolved either. energydata.info lists Global Wind Atlas only as a link to the website, with no data resources. DTU may hold an archive; that has not been asked. Treat the cluster copy as the only one we have."
  },
