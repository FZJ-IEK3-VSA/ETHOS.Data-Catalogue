  "ethos:visibility": "public",
  "ethos:upstream": {
    "status": "on-request",
    "checked": "2026-09-07",
    "note": "Not downloadable from the CLMS in any form. The EEA record for V2018_20 carries no download link, only WMS view services, and is marked OBSOLETE. The pre-packaged-files API offers 27 CORINE pre-packages across all reference years and change layers; all 27 are v2020_20u1, and CLMS reports previous_item: {}. The remaining route is a request to JRC-Copernicus-Land@ec.europa.eu; whether they still supply v20 is untested. This mirror is therefore the copy of record."
  },
  "ethos:coverage_note": "This mirror holds the CLC2018 reference year of the version-20 100 m raster delivery, plus the five French overseas departments. It does not hold the 1990, 2000, 2006 or 2012 reference years, nor any of the change layers that the version-20 delivery also contains. Those were never downloaded; they are available from the EEA on request.",
