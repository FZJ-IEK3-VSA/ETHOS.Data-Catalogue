{
  "$schema": "https://datapackage.org/profiles/2.0/datapackage.json",
  "name": "corine-land-cover",
  "title": "CORINE Land Cover 2018, 100 m raster, version 20 (Europe)",
  "description": "CORINE Land Cover for reference year 2018, as the European seamless 100 m raster (version 20, May 2019) in EPSG:3035, with the 44-class CLC nomenclature, its colour table and value-attribute table, and separate rasters for the five French overseas departments. Produced by the European Environment Agency for the Copernicus Land Monitoring Service. A higher-resolution European alternative to the global 300 m `landcover` dataset for land-use exclusion and surface-roughness work. Holds the 2018 reference year only -- see ethos:coverage_note.",
  "homepage": "https://land.copernicus.eu/en/products/corine-land-cover/clc2018",
  "id": "copernicus_r_3035_100_m_clc-2018_p_2017-2018_v20_r00",
  "version": "V2018_20",
  "ethos:remote_prefix": "corine-land-cover",
