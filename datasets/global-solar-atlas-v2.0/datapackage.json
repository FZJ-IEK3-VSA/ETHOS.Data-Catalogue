{
  "$schema": "https://datapackage.org/profiles/2.0/datapackage.json",
  "name": "global-solar-atlas-v2.0",
  "title": "Global Solar Atlas 2.0, long-term average solar resource and air temperature (250 m, to 2018)",
  "description": "Long-term averages of global horizontal irradiation (GHI), direct normal irradiation (DNI), diffuse horizontal irradiation (DIF) and global irradiation at optimum tilt (GTI) on a 9 arcsec (about 250 m) grid, plus monthly photovoltaic power potential (PVOUT), air temperature at 2 m (TEMP), the optimum tilt angle (OPTA) and terrain elevation (ELE) on coarser grids, as global GeoTIFFs. Data period to 2018: the database introduced with Global Solar Atlas 2.0 (October 2019). Produced by Solargis for the World Bank / ESMAP. RESKit's CSP workflows take DNI and TEMP from this vintage. The newer releases are catalogued separately as global-solar-atlas-v2.9 and global-solar-atlas-v2.13, the 2017 one as global-solar-atlas-v1.0.",
  "homepage": "https://globalsolaratlas.info/",
  "version": "2.0",
  "ethos:exclude": [
    "**/*.zip",
    "Cabo-Verde_GISdata_LTAy_DailySum_GlobalSolarAtlas_GEOTIFF"
  ],
  "ethos:remote_prefix": "global-solar-atlas-v2.0",
  "ethos:access": "public",
  "ethos:visibility": "public",
  "ethos:upstream": {
    "status": "superseded",
    "checked": "2026-09-29",
    "note": "Checked 2026-09-29. api.globalsolaratlas.info/download/World/ still serves files under the same names for GHI, DNI, DIF, GTI, ELE, TEMP and PVOUT, but they are now Global Solar Atlas 2.13 (GHI and DNI published 2026-04 with data to 2025; ELE edition 2024-05), not the 2018 layers held here. GHI, DNI and ELE were compared by their zip directories and every member differs in size and CRC-32; DIF, GTI, PVOUT and TEMP were last modified 2026-05-06 and were not opened. The OPTA address listed in the energydata.info catalogue answers 404. The addresses carry no version, and the host answers 404 to HEAD while serving GET."
  },
