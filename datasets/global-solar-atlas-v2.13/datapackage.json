{
  "$schema": "https://datapackage.org/profiles/2.0/datapackage.json",
  "name": "global-solar-atlas-v2.13",
  "title": "Global Solar Atlas 2.13, long-term average solar resource and air temperature (250 m, to 2025)",
  "description": "Long-term averages of global horizontal irradiation (GHI), direct normal irradiation (DNI), diffuse horizontal irradiation (DIF) and global irradiation at optimum tilt (GTI) on a 9 arcsec (about 250 m) grid, plus photovoltaic power potential (PVOUT, yearly and monthly), air temperature at 2 m (TEMP), the optimum tilt angle (OPTA) and terrain elevation (ELE) on coarser grids, as global GeoTIFFs. Global Solar Atlas 2.13 (May 2026), data to 2025, produced by Solargis for the World Bank / ESMAP. RESKit's PV workflows use GHI and DNI to bias-correct ERA5 irradiance; the CSP workflows use DNI and TEMP to pick the optimal heat transfer fluid per placement. This is the current vintage; the older ones are catalogued separately as global-solar-atlas-v2.9, -v2.0 and -v1.0.",
  "homepage": "https://globalsolaratlas.info/",
  "version": "2.13",
  "ethos:exclude": [
    "**/*.zip",
    "download.sh",
    "download.log",
    "DONE"
  ],
  "ethos:remote_prefix": "global-solar-atlas-v2.13",
  "ethos:access": "public",
  "ethos:visibility": "public",
  "ethos:upstream": {
    "status": "available",
    "checked": "2026-09-29",
    "note": "Checked 2026-09-29. api.globalsolaratlas.info/download/World/ (a 302 to S3) serves these files now; the listing at /download/World gives every file a size and a lastModified, 2026-05-06 for all but ELE (2025-05-05). The addresses are VERSION-LESS, so what they return changes with each release: this entry becomes \"superseded\" as soon as GSA 2.14 or later replaces the files. The GSA site does not list them; the energydata.info (ESMAP / World Bank) catalogue does. The host answers 404 to HEAD while serving GET, which makes the URLs look dead when probed casually."
  },
