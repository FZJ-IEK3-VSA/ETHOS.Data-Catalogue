{
  "$schema": "https://datapackage.org/profiles/2.0/datapackage.json",
  "name": "global-solar-atlas-v1.0",
  "title": "Global Solar Atlas 1.0, long-term average solar resource and air temperature (1 km)",
  "description": "Long-term averages of global horizontal irradiation (GHI), direct normal irradiation (DNI), diffuse horizontal irradiation (DIF), global irradiation at optimum tilt (GTI), photovoltaic power potential (PVOUT), air temperature at 2 m (TEMP) and terrain elevation (ELE), as global GeoTIFFs on a 30 arcsec (about 1 km) grid. The first release of the Global Solar Atlas (January 2017), produced by Solargis for the World Bank / ESMAP. Superseded by 2.0, which moved to a 9 arcsec (about 250 m) grid; the later releases are catalogued separately as global-solar-atlas-v2.0, global-solar-atlas-v2.9 and global-solar-atlas-v2.13.",
  "homepage": "https://globalsolaratlas.info/",
  "version": "1.0",
  "ethos:exclude": [
    "**/*.zip",
    "**/*.aux.xml",
    "**/gsa-dni-like.tif",
    "sample_8_7_4"
  ],
