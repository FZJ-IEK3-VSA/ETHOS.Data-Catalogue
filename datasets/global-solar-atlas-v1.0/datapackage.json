  "ethos:visibility": "public",
  "ethos:upstream": {
    "status": "withdrawn",
    "checked": "2026-09-29",
    "note": "Checked 2026-09-29. The Global Solar Atlas no longer offers this release. The download API at api.globalsolaratlas.info/download/World/ answers 404 for the 1.0 file names (tried World_GHI_GISdata_LTAy_DailySum_GlobalSolarAtlas_GEOTIFF.zip and the TEMP equivalent), and the energydata.info records for the world layers link only the 2.x files. The 2.x files under similar names are a different product: 9 arcsec grid, later data period."
  },
